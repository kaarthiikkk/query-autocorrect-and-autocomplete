{
  "manifest_version": 3,
  "name": "Multilingual Search Intelligence & Spelling Assistant",
  "version": "1.1.0",
  "description": "Real-time predictive search omnibox and Grammarly-style multilingual spelling assistant with red wavy underlines and one-click corrections across supported websites.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Multilingual Search Intelligence",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "storage",
    "clipboardWrite",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "<all_urls>"
  ]
}
